<div class="max-w-6xl mx-auto bg-white shadow-lg rounded-xl p-6 sm:p-10 flex flex-col gap-4">
    <h1 class="text-3xl font-bold text-gray-900 mb-6 border-b pb-2"><%= title %></h1>

    <div class="flex flex-col md:flex-row gap-8">
        <div class="md:w-1/3 flex flex-col items-center gap-4">
            <div class="bg-gray-50 p-4 rounded-lg border border-gray-200 text-center w-full">
                <% if (book.fileCover) { %>
                    <img src="/<%= book.fileCover %>" alt="Book Cover" class="max-w-full h-auto object-cover rounded-md shadow-md mb-6 mx-auto max-h-96">
                <% } else { %>
                    <div class="w-full h-64 bg-gray-200 flex items-center justify-center rounded-md text-gray-500 border-dashed border-2 mb-6">
                        No Cover Image Available
                    </div>
                <% } %>

                <% if (book.fileBook) { %>
                    <div class="mt-4 p-3 bg-indigo-50 rounded-lg flex justify-center items-center space-x-2">
                        <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                        <span class="text-sm text-indigo-700">Download Book File:</span>
                        <a href="/api/books/<%= book.id %>/download" download="<%= book.fileName || 'book' %>" class="px-3 py-1 bg-indigo-600 text-white text-sm rounded hover:bg-indigo-700 transition duration-150">
                            Download File
                        </a>
                    </div>
                <% } else { %>
                    <div class="mt-4 p-3 bg-yellow-50 border border-yellow-200 text-yellow-800 rounded-lg flex items-center space-x-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.5-1.36 2.5-3.03V7c0-1.67-1.36-3.03-3.03-3.03H5c-1.67 0-3.03 1.36-3.03 3.03v8.94c0 1.67 1.36 3.03 3.03 3.03z"></path></svg>
                        <span>No book file attached for download.</span>
                    </div>
                <% } %>

                
            </div>

            <div class="flex items-center justify-center w-full gap-2">
                <a href="/book/<%= book.id %>/update" class="w-full text-center px-4 py-2 bg-indigo-600 text-white rounded-lg shadow hover:bg-indigo-700 transition duration-150 cursor-pointer">Edit Book</a>
                <button onclick="if(confirm('Are you sure you want to delete this book?')) { window.location.href='/book/<%= book.id %>/delete'; }" class="w-full px-4 py-2 bg-red-600 text-white rounded-lg shadow hover:bg-red-700 transition duration-150 cursor-pointer">Delete Book</button>
            </div>
        </div>

        <div class="md:w-2/3 flex flex-col justify-start md:pt-4">
            <p class="mb-4"><strong class="text-gray-700">Title: </strong class="sm:text-lg"><%= book.title %></p>
            <p class="mb-4"><strong class="text-gray-700">Authors: </strong class="sm:text-lg"><%= book.authors %></p>
            <p class="mb-4"><strong class="text-gray-700">Description: </strong class="sm:text-lg"><%= book.description %></p>
            <p class="mb-4"><strong class="text-gray-700">Favorite: </strong class="sm:text-lg"><%= book.favorite ? "Yes" : "No" %></p>
            <% if (count !== null) { %>
                <p class="mb-4"><strong class="text-gray-700">Views: </strong class="sm:text-lg"><%= count %></p>
            <% } %>
        </div>
    </div>
</div>