<div class="max-w-6xl mx-auto bg-white shadow-lg rounded-xl p-6 sm:p-10 flex flex-col gap-4">
    <div class="flex flex-col md:flex-row gap-8">
        <div class="md:w-1/3 flex flex-col items-center gap-4">
            <div class="bg-gray-50 p-4 rounded-lg border border-gray-200 text-center w-full">
                <% if (book.fileCover) { %>
                    <img src="/<%= book.fileCover %>" alt="Book Cover" class="max-w-full h-auto object-cover rounded-md shadow-md mb-6 mx-auto max-h-96">
                <% } else { %>
                    <div class="w-full h-64 bg-gray-200 flex items-center justify-center rounded-md text-gray-500 border-dashed border-2 mb-6">
                        No Cover Image Available
                    </div>
                <% } %>

                <% if (book.fileBook) { %>
                    <div class="mt-4 p-3 bg-indigo-50 rounded-lg flex justify-center items-center space-x-2">
                        <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                        <span class="text-sm text-indigo-700">Download Book File:</span>
                        <a href="/api/books/<%= book.id %>/download" download="<%= book.fileName || 'book' %>" class="px-3 py-1 bg-indigo-600 text-white text-sm rounded hover:bg-indigo-700 transition duration-150">
                            Download File
                        </a>
                    </div>
                <% } else { %>
                    <div class="mt-4 p-3 bg-yellow-50 border border-yellow-200 text-yellow-800 rounded-lg flex items-center space-x-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.5-1.36 2.5-3.03V7c0-1.67-1.36-3.03-3.03-3.03H5c-1.67 0-3.03 1.36-3.03 3.03v8.94c0 1.67 1.36 3.03 3.03 3.03z"></path></svg>
                        <span>No book file attached for download.</span>
                    </div>
                <% } %>

                
            </div>

            <div class="flex items-center justify-center w-full gap-2">
                <a href="/book/<%= book.id %>/update" class="w-full text-center px-4 py-2 bg-indigo-600 text-white rounded-lg shadow hover:bg-indigo-700 transition duration-150 cursor-pointer">Edit Book</a>
                <button onclick="if(confirm('Are you sure you want to delete this book?')) { window.location.href='/book/<%= book.id %>/delete'; }" class="w-full px-4 py-2 bg-red-600 text-white rounded-lg shadow hover:bg-red-700 transition duration-150 cursor-pointer">Delete Book</button>
            </div>
        </div>

        <div class="md:w-2/3 flex flex-col justify-start md:pt-4">
            <p class="mb-4"><strong class="text-gray-700">Title: </strong class="sm:text-lg"><%= book.title %></p>
            <p class="mb-4"><strong class="text-gray-700">Authors: </strong class="sm:text-lg"><%= book.authors %></p>
            <p class="mb-4"><strong class="text-gray-700">Description: </strong class="sm:text-lg"><%= book.description %></p>
            <p class="mb-4"><strong class="text-gray-700">Favorite: </strong class="sm:text-lg"><%= book.favorite ? "Yes" : "No" %></p>
            <% if (count !== null) { %>
                <p class="mb-4"><strong class="text-gray-700">Views: </strong class="sm:text-lg"><%= count %></p>
            <% } %>
        </div>
    </div>

    <div class="mt-8 pt-8 border-t border-gray-200 flex flex-col gap-4">
    <div class="flex items-center justify-between">
      <h3 class="text-xl font-bold text-gray-800 flex items-center gap-2">
        <svg
          class="w-6 h-6 text-indigo-600"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
          ></path>
        </svg>
        Обсуждение книги
      </h3>
    </div>

    <div
      id="chat"
      class="h-80 overflow-y-auto bg-gray-50 p-4 rounded-xl border border-gray-200 flex flex-col gap-3"
    ></div>

    <div
      class="flex flex-col gap-3 bg-gray-50 p-4 rounded-xl border border-gray-200"
    >
      <textarea
        id="message"
        rows="3"
        placeholder="Напишите мысль о прочитанном... (Enter — отправить, Shift+Enter — новая строка)"
        class="w-full p-3 bg-white border border-gray-300 rounded-lg text-sm text-gray-800 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition duration-150 resize-y"
      ></textarea>

      <div class="flex justify-end">
        <button
          onclick="sendMessage()"
          class="px-5 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg shadow hover:bg-indigo-700 active:scale-95 transition duration-150 cursor-pointer flex items-center gap-2"
        >
          <span>Отправить</span>
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M14 5l7 7m0 0l-7 7m7-7H3"
            ></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div
    id="data"
    data-book-id="<%= book.id %>"
    data-user="<%= currentUser.username %>"
  ></div>

  <script>
    const dataContainer = document.getElementById("data");
    const bookId = dataContainer.dataset.bookId;
    const currentUsername = dataContainer.dataset.user;

    const socket = io();
    const chatDiv = document.getElementById("chat");
    const msgInput = document.getElementById("message");

    socket.on("connect", () => {
      socket.emit("joinBookRoom", bookId);
    });

    socket.on("newComment", (msg) => {
      const authorName = msg.user;

      const isMe = authorName === currentUsername;
      const msgElement = document.createElement("div");

      if (isMe) {
        msgElement.className =
          "self-end max-w-[80%] bg-indigo-600 text-white p-3 rounded-2xl rounded-tr-none shadow-sm flex flex-col gap-1 transition duration-150";

        const textDiv = document.createElement("div");
        textDiv.className =
          "text-sm whitespace-pre-wrap break-words leading-relaxed";
        textDiv.textContent = msg.text;

        const timeSpan = document.createElement("span");
        timeSpan.className = "text-indigo-200 text-[10px] self-end mt-0.5";
        timeSpan.textContent =
          msg.time ||
          new Date().toLocaleTimeString([], {
            hour: "2-digit",
            minute: "2-digit",
          });

        msgElement.appendChild(textDiv);
        msgElement.appendChild(timeSpan);
      } else {
        msgElement.className =
          "self-start max-w-[80%] bg-white p-3 rounded-2xl rounded-tl-none border border-gray-200 shadow-sm flex flex-col gap-1 transition duration-150";

        const headerDiv = document.createElement("div");
        headerDiv.className =
          "flex justify-between items-center gap-3 text-xs mb-0.5";

        const authorSpan = document.createElement("span");
        authorSpan.className = "font-bold text-indigo-600 text-[13px]";
        authorSpan.textContent = authorName;

        const timeSpan = document.createElement("span");
        timeSpan.className = "text-gray-400 text-[10px]";
        timeSpan.textContent =
          msg.time ||
          new Date().toLocaleTimeString([], {
            hour: "2-digit",
            minute: "2-digit",
          });

        headerDiv.appendChild(authorSpan);
        headerDiv.appendChild(timeSpan);

        const textDiv = document.createElement("div");
        textDiv.className =
          "text-gray-800 text-sm whitespace-pre-wrap break-words leading-relaxed";
        textDiv.textContent = msg.text;

        msgElement.appendChild(headerDiv);
        msgElement.appendChild(textDiv);
      }

      chatDiv.appendChild(msgElement);
      chatDiv.scrollTop = chatDiv.scrollHeight;
    });

    function sendMessage() {
      const text = msgInput.value.trim();
      if (!text) return;

      socket.emit("comment", {
        bookId: bookId,
        user: currentUsername,
        text: text,
      });

      msgInput.value = "";
    }

    msgInput.addEventListener("keydown", (e) => {
      if (e.key === "Enter" && !e.shiftKey) {
        e.preventDefault();
        sendMessage();
      }
    });
  </script>
</div>