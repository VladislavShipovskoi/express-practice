<div class="max-w-6xl mx-auto bg-white shadow-lg rounded-xl p-6 sm:p-10">
    <div class="flex justify-between items-center mb-8">
        <h2 class="text-2xl font-semibold text-gray-700"><%= title %></h2>
        <a href="/book/create" class="px-4 py-2 bg-indigo-600 text-white rounded-lg cursor-pointer">
            + Add Book
        </a>
    </div>
    
    <% if (books && books.length > 0) { %>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-indigo-600 text-white">
                    <tr>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase">ID</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase">Title</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase">Authors</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase">description</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase">favorite</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    <% books.forEach((book) => { %>
                        <tr class="cursor-pointer" onclick="window.location.href='/book/<%= book.id %>'">
                            <td class="px-6 py-4"><%= book.id %></td>
                            <td class="px-6 py-4"><%= book.title %></td>
                            <td class="px-6 py-4"><%= book.authors %></td>
                            <td class="px-6 py-4"><%= book.description %></td>
                            <td class="px-6 py-4"><%= book.favorite ? "Yes" : "No" %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } else { %>
        <div class="p-12 text-center bg-gray-50 rounded-lg border border-dashed border-gray-300">
            <h2 class="text-xl font-semibold text-gray-600 mb-2">No books found.</h2>
            <p class="text-gray-400">Try adding some books to your library.</p>
        </div>
    <% } %>
</div>